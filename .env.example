# ===============================
# AVAILABLE_MODULES Configuration
# ===============================
# CRITICAL: This MUST be valid JSON
# Format: {"moduleName": "DB_URI_ENV_VAR_NAME", ...}
# 
# Core modules (always connected): user, company, audit, master
# Optional modules (conditionally connected): accounting, invoice
#
# ⚠️  AZURE DEPLOYMENT NOTE:
#   Include this exact JSON string in Azure App Service Configuration:
#   Name: AVAILABLE_MODULES
#   Value: {"user": "USER_DB_URI", "company": "COMPANY_DB_URI", "audit": "AUDIT_DB_URI", "master": "MASTER_DB_URI", "accounting": "ACCOUNTING_DB_URI", "invoice": "INVOICE_DB_URI"}
#   
#   DO NOT add extra backslashes - Azure handles JSON escaping automatically

AVAILABLE_MODULES={"user": "USER_DB_URI", "company": "COMPANY_DB_URI", "audit": "AUDIT_DB_URI", "master": "MASTER_DB_URI", "accounting": "ACCOUNTING_DB_URI", "invoice": "INVOICE_DB_URI"}

# ===============================
# JWT Configuration
# ===============================
# IMPORTANT: In production, use strong secrets (min 32 characters)
JWT_ACCESS_SECRET=your_access_secret_here_min_32_chars
JWT_REFRESH_SECRET=your_refresh_secret_here_min_32_chars
ACCESS_TOKEN_EXPIRES_IN=1000m
REFRESH_TOKEN_EXPIRES_IN=30d

# ===============================
# Cookie Configuration
# ===============================
REFRESH_TOKEN_COOKIE_NAME=jid

